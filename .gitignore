*~
*.elc

# Packages are installed from package-selected-packages in init.el,
# not committed.
elpa/
eln-cache/

# Tree-sitter grammars are built per machine by install.sh.
tree-sitter/

# Runtime state Emacs writes for itself: caches, histories, rankings.
# All per-machine, none of it worth carrying to a new one.
auto-save-list/
backups/
history
network-security.data
bookmarks
prescient-save.el
projectile-bookmarks.eld
projectile-frecency.eld
transient/
url/
tramp
.mc-lists.el
.~undo-tree~

# Custom writes here; everything intentional lives in init.el.
custom.el
